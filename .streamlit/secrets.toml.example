# Template for Streamlit Community Cloud: paste into the app's
# Settings -> Secrets box with real values. Never commit a filled-in copy;
# .streamlit/secrets.toml is gitignored.

# Use a key from a dedicated OpenAI project that has its own monthly budget
# limit, so the worst case is capped by OpenAI rather than by this app.
OPENAI_API_KEY = "sk-..."

# Demo mode is automatic when DATABASE_URL is absent; set it explicitly anyway.
DEMO_MODE = "true"

# Optional overrides (defaults shown). Each extraction or dispute letter is one call.
# DEMO_SESSION_DAILY_LIMIT = "5"    # per browser session
# DEMO_IP_DAILY_LIMIT = "20"        # per client IP, survives page refreshes
# DEMO_GLOBAL_DAILY_LIMIT = "150"   # all visitors combined
# DEMO_MAX_INPUT_CHARS = "6000"     # longest invoice text accepted
